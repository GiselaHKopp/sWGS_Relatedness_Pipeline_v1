/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
        ext.when   = Condition for running the module.
----------------------------------------------------------------------------------------
*/

process {
    withName: '.*:BASE_QUALITY_SCORE_RECALIBRATION:GATK4_ANALYZECOVARIATES' {
        ext.when = { params.known_variants_vcf }
    }
    withName: '.*:BASE_QUALITY_SCORE_RECALIBRATION:GATK4_APPLYBQSR' {
        ext.when = { params.known_variants_vcf }
    }
    withName: '.*:BASE_QUALITY_SCORE_RECALIBRATION:SAMTOOLS_INDEX' {
        ext.when = { params.known_variants_vcf }
    }
    withName: '.*:BASE_QUALITY_SCORE_RECALIBRATION:SAMTOOLS_INDEX_SCATTERED' {
        ext.when = { params.known_variants_vcf }
    }
    withName: '.*:BASE_QUALITY_SCORE_RECALIBRATION:SAMTOOLS_MERGE' {
        ext.when = { params.known_variants_vcf }
    }
    withName: '.*:BASE_QUALITY_SCORE_RECALIBRATION:CRAM_BASERECALIBRATOR:GATK4_BASERECALIBRATOR' {
        ext.when = { params.known_variants_vcf }
    }
    withName: '.*:BASE_QUALITY_SCORE_RECALIBRATION:CRAM_BASERECALIBRATOR:GATK4_GATHERBQSRREPORTS' {
        ext.when = { params.known_variants_vcf }
    }
}
